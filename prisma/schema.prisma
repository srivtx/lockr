generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Escrow {
  id               String       @id @default(cuid())
  escrowId         String       @unique @map("escrow_id")
  paymentId        String?      @unique @map("payment_id")
  solanaPda        String       @unique @map("solana_pda")
  freelancerWallet String       @map("freelancer_wallet")
  clientEmail      String       @map("client_email")
  clientEmailHash  String       @map("client_email_hash")
  clientPublicKey  String?      @map("client_public_key")
  totalAmount      BigInt       @map("total_amount")
  status           EscrowStatus @default(CREATED)
  deadline         DateTime
  seed             BigInt       @default(0)
  fundingSignature String?      @map("funding_signature")
  clientSecretKey  String?      @unique @map("client_secret_key")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  milestones    Milestone[]
  paymentEvents PaymentEvent[]

  @@index([freelancerWallet])
  @@index([status])
  @@map("escrows")
}

model Milestone {
  id             String          @id @default(cuid())
  escrowId       String          @map("escrow_id")
  index          Int
  description    String
  amount         BigInt
  status         MilestoneStatus @default(PENDING)
  deliverableUrl String?         @map("deliverable_url")
  completedAt    DateTime?       @map("completed_at")
  releasedAt     DateTime?       @map("released_at")

  escrow Escrow @relation(fields: [escrowId], references: [id])

  @@unique([escrowId, index])
  @@map("milestones")
}

model PaymentEvent {
  id                    String    @id @default(cuid())
  dodoPaymentId         String    @unique @map("dodo_payment_id")
  dodoCheckoutSessionId String    @map("dodo_checkout_session_id")
  status                String
  metadata              Json?
  signature             String?
  completedAt           DateTime? @map("completed_at")

  escrowId String? @map("escrow_id")
  escrow   Escrow? @relation(fields: [escrowId], references: [id])

  @@map("payment_events")
}

enum EscrowStatus {
  CREATED
  FUNDING
  FUNDED
  IN_PROGRESS
  COMPLETED
  DISPUTED
  REFUNDED
  FAILED
}

enum MilestoneStatus {
  PENDING
  FUNDED
  IN_PROGRESS
  COMPLETED
  RELEASED
  DISPUTED
  REFUNDED
}
