# Dodo Payments (Test Mode)
# Get these from https://app.dodopayments.com → Developer → API Keys
DODO_API_KEY=dodo_test_xxx
DODO_WEBHOOK_KEY=whsec_xxx
DODO_ENVIRONMENT=test_mode

# Solana / Helius
# Get free devnet RPC key from https://helius.dev
HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
NEXT_PUBLIC_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# Escrow hot wallet keypair (JSON array of 64 bytes) — devnet only
# Generate: solana-keygen new --outfile escrow.json
# Convert to JSON array: node -e "const fs=require('fs');const data=JSON.parse(fs.readFileSync('escrow.json'));console.log(JSON.stringify(Array.from(data.slice(0,64))))"
ESCROW_KEYPAIR=[64,123,45,...]

# Supabase PostgreSQL (Free Tier)
# 1. Create project at https://supabase.com
# 2. Go to Settings → Database → Connection string
# 3. Use Session pooler (port 5432) or Transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Upstash Redis (Free Tier — Serverless)
# 1. Create database at https://upstash.com
# 2. Go to Details → Redis Connect → Node.js
# 3. Use the REST URL or Redis URL
REDIS_URL=rediss://default:[password]@[endpoint]:6379

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Anchor Program ID (update after deploying to devnet)
NEXT_PUBLIC_SOLANA_PROGRAM_ID=F6PigaZhXTPpb6ao46yr4U4gWBzv5xqKPps7szv6AGyD
